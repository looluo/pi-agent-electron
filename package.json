{
  "name": "pi-agent-desktop",
  "version": "0.9.1",
  "private": true,
  "description": "Pi Agent App - Electron desktop app for the pi coding agent",
  "main": "out/main/main.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package:dir": "electron-vite build && electron-builder --win --dir --config.npmRebuild=false --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --dir --config.npmRebuild=false --publish never",
    "package:mac:dmg": "electron-vite build && electron-builder --mac dmg --config.npmRebuild=false --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"pi-web/src/**/*.test.mjs\"",
    "test:e2e": "electron-vite build && playwright test",
    "package:zip": "npm run package:dir && powershell -Command \"Compress-Archive -Path release/win-unpacked/* -DestinationPath release/Pi-Agent-App-0.9.1-portable.zip -Force\""
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "node-pty": "^1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "semver": "^7.8.0",
    "undici": "8.10.0"
  }
}
