{
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "target": "ES2022"
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts"]
}
